# VHS tape for the README hero GIF. Render: vhs docs/demo/demo.tape
# Colors follow the Agenterr design system (flat #0b0d10, indigo accent).

Output docs/media/demo.gif

Set FontSize 15
Set FontFamily "JetBrainsMono Nerd Font"
Set Width 1180
Set Height 640
Set Padding 24
Set Theme { "background": "#0b0d10", "foreground": "#ededf0", "black": "#0b0d10", "red": "#f47067", "green": "#3fb950", "yellow": "#c69026", "blue": "#7c8ce8", "magenta": "#a78bfa", "cyan": "#7c8ce8", "white": "#ededf0", "brightBlack": "#8b949e", "brightRed": "#f47067", "brightGreen": "#3fb950", "brightYellow": "#c69026", "brightBlue": "#7c8ce8", "brightMagenta": "#a78bfa", "brightCyan": "#7c8ce8", "brightWhite": "#ededf0", "cursor": "#7c8ce8", "selection": "#2c3550" }

Hide
Type "bash docs/demo/replay.sh"
Enter
Show
Sleep 16s
